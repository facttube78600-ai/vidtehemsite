# VidTheme — clean video theme (static site, dynamic videos)

# Cloudflare Pages rewrites (the Pages Function functions/[[path]].js
# is the authoritative router and also returns a real 404 for
# unknown paths; these rewrites keep the same behaviour for
# direct visits to clean URLs).
/video/*  /index.html  200
/*/*.html /index.html  200
/tags/*   /index.html  200
/page/*   /index.html  200
/search   /index.html  200
/terms    /index.html  200
/privacy  /index.html  200
/contact  /index.html  200
/dmca     /index.html  200
